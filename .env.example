# Node.js 24+. Variáveis do servidor; não copie caminhos locais para a Vercel.
# Obrigatória: ID do projeto, sem .firebaseapp.com.
FIREBASE_PROJECT_ID=datamat-ml
# Opcional: valida se o JSON corresponde a esta conta de serviço.
FIREBASE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-fbsvc@datamat-ml.iam.gserviceaccount.com
# Obrigatória na Vercel: JSON administrativo completo, como variável Sensitive.
# No painel, cole somente o JSON. Para importar .env, use JSON em uma linha entre aspas simples.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Somente local: alternativa ao JSON secreto; não cadastrar na Vercel.
FIREBASE_ADMIN_CREDENTIALS_PATH=
# Application Default Credentials são permitidas fora da Vercel.
# FIRESTORE_EMULATOR_HOST é exclusivo dos testes demo-* e proibido na Vercel.
# Obrigatória na publicação: substituir localhost pela URL HTTPS real e fazer Redeploy.
APP_URL=http://localhost:3000
# Opcional: nome exibido no histórico, padrão Operador.
APP_OPERATOR_NAME=Operador
# Opcionais e não utilizadas pelo navegador nesta versão. Não autorizam acesso administrativo.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDmBVfO6pEiTHy1anem48Qiqkcxb63MGys
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=datamat-ml.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=datamat-ml
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=datamat-ml.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=374456825775
NEXT_PUBLIC_FIREBASE_APP_ID=1:374456825775:web:6bb83d53e4d1d2123ce15a
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-KFY9XQS6FF
# Compatibilidade com instalações antigas. Novas credenciais ML são cadastradas por loja no site.
# Não é necessário criar estas três variáveis para adicionar lojas ou aplicações.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
# O site informa automaticamente as URLs de retorno e notificações usando APP_URL.
# Opcional com conta Firebase: a identidade administrativa protege as integrações.
# Se esta chave base64 de 32 bytes já existe, preserve o valor para abrir dados existentes.
ML_TOKEN_ENCRYPTION_KEY=
# Integrações ainda pendentes; deixar sem configurar nesta versão.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=
AI_API_KEY=
# Opcional: link HTTPS para um relatório existente.
POWER_BI_REPORT_URL=
